# Copy to .env and fill in real values. .env is git-ignored.

# --- Database ---
MYSQL_DATABASE=wordpress
MYSQL_USER=wp
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# --- Ports: one block of ten per project (see compose.yaml) ---
WP_PORT=8080
PMA_PORT=8081

# --- WordPress site (used only by bin/setup.sh on an empty database) ---
WP_URL=http://localhost:8080
WP_TITLE="WP Booking"
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me
WP_ADMIN_EMAIL=you@example.com

# The Booqable access token is not an environment variable. Paste it in
# wp-admin > Settings > Booqable Rental Core; it is stored server-side only.
